FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tor ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/tor \
    && chown debian-tor:debian-tor /var/log/tor

COPY torrc /etc/tor/torrc
USER debian-tor
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=24 \
  CMD grep -q 'Bootstrapped 100%' /var/log/tor/notices.log || exit 1
ENTRYPOINT ["tor", "-f", "/etc/tor/torrc"]
