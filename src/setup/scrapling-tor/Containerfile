FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tor ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

COPY torrc /etc/tor/torrc
COPY service_supervisor.py pinning_gateway.py binary_acquisition.py /opt/basix/
ENV PYTHONDONTWRITEBYTECODE=1
USER debian-tor
# Fail the build if the supervisor's runtime imports or permissions are incomplete.
RUN python3 /opt/basix/service_supervisor.py --help >/dev/null \
    && python3 /opt/basix/pinning_gateway.py --help >/dev/null
HEALTHCHECK --interval=15s --timeout=8s --start-period=120s --retries=3 \
  CMD python3 /opt/basix/service_supervisor.py --probe tor >/dev/null 2>&1
ENTRYPOINT ["python3", "/opt/basix/service_supervisor.py", "tor"]
