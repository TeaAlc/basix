{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basix.local/schemas/agent-message-1.4.json",
  "title": "Basix agent communication message",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "message_type", "agent_name", "task_name", "sequence", "cycle_revision", "status", "summary", "data", "errors"],
  "properties": {
    "contract_version": {"const": "1.4"},
    "message_type": {"enum": ["plan", "status", "issue", "permission_request", "report_started", "intermediate_result", "final_result"]},
    "agent_name": {"type": "string", "minLength": 1},
    "task_name": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "cycle_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["planned", "in_progress", "blocked", "completed", "completed_with_errors", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "data": {},
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["warning", "error", "fatal"]},
        "retryable": {"type": "boolean"},
        "details": {}
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "checked"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "plan_data": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plan_revision", "checklist"],
      "properties": {
        "plan_revision": {"type": "integer", "minimum": 1},
        "checklist": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/checklist_item"}}
      }
    },
    "permission_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "action", "reason", "required_permission", "scope", "blocks_current_step"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "required_permission": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "blocks_current_step": {"type": "boolean"}
      }
    },
    "report_started_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_type"],
      "properties": {
        "report_type": {"enum": ["intermediate_result", "final_result"]}
      }
    },
    "concise_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["warning", "error", "fatal"]},
        "retryable": {"type": "boolean"}
      }
    },
    "final_data": {
      "if": {"type": "object"},
      "then": {
        "properties": {
          "subagent_insights": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      }
    },
    "non_final_data": {
      "if": {"type": "object"},
      "then": {"not": {"required": ["subagent_insights"]}}
    }
  },
  "allOf": [
    {"if": {"properties": {"message_type": {"const": "plan"}}}, "then": {"properties": {"status": {"const": "planned"}, "data": {"$ref": "#/$defs/plan_data"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"message_type": {"const": "status"}}}, "then": {"properties": {"status": {"const": "in_progress"}, "data": {"$ref": "#/$defs/plan_data"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"message_type": {"const": "issue"}}}, "then": {"properties": {"data": {"type": "null"}, "errors": {"minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/concise_error"}}}}},
    {"if": {"properties": {"message_type": {"const": "report_started"}}}, "then": {"properties": {"status": {"const": "in_progress"}, "data": {"$ref": "#/$defs/report_started_data"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"message_type": {"const": "intermediate_result"}}}, "then": {"properties": {"data": {"type": "null"}, "errors": {"maxItems": 3, "items": {"$ref": "#/$defs/concise_error"}}}}},
    {"if": {"properties": {"message_type": {"const": "permission_request"}}}, "then": {"properties": {"status": {"const": "blocked"}, "data": {"$ref": "#/$defs/permission_data"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"message_type": {"const": "final_result"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/final_data"}}}, "else": {"properties": {"data": {"$ref": "#/$defs/non_final_data"}}}},
    {"if": {"properties": {"message_type": {"const": "final_result"}, "status": {"const": "completed"}}}, "then": {"properties": {"errors": {"maxItems": 0}}}},
    {"if": {"properties": {"message_type": {"const": "final_result"}, "status": {"const": "completed_with_errors"}}}, "then": {"properties": {"data": {"not": {"type": "null"}}, "errors": {"minItems": 1}}}},
    {"if": {"properties": {"message_type": {"const": "final_result"}, "status": {"const": "failed"}}}, "then": {"properties": {"errors": {"minItems": 1}}}}
  ]
}
